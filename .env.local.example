# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI — app default key used when user selects "Use app default key (.env)" in API Configuration
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# App URL — used for Supabase email confirmation redirects
# In dev: http://localhost:3000  |  In Vercel: set to https://your-app.vercel.app (or leave empty to auto-use VERCEL_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
